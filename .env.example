# ---- Google Cloud / BigQuery ----
GCP_PROJECT_ID=your-gcp-project-id
BQ_LOCATION=US
# Dataset Airbyte writes to (set the same name in the Airbyte BigQuery destination)
BQ_RAW_DATASET=retail_raw
# Table (stream) name created by Airbyte (= "Dataset Name" in the Airbyte File source)
RAW_TABLE=retail_sales
# dbt base dataset. dbt creates <base>_staging and <base>_marts
BQ_ANALYTICS_DATASET=retail_analytics
# Dataset the Streamlit app reads from (must be <BQ_ANALYTICS_DATASET>_marts)
BQ_MARTS_DATASET=retail_analytics_marts
# Path to the service-account key. Host path for local runs, container path under Docker.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-key.json

# ---- Airbyte (local, installed with abctl) ----
AIRBYTE_CONNECTION_ID=00000000-0000-0000-0000-000000000000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# ---- Airflow (Docker) ----
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change-me
# Optional sanity check used by the validation task (leave empty to skip)
EXPECTED_ROW_COUNT=1000
